# =============================================================================
# Tutor Agent — non-secret configuration (.env.example)
# Copy to `.env` and set OPENAI_API_KEY locally. Never commit `.env`.
# Never put secrets in VITE_ / frontend variables.
# =============================================================================

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODERATION_MODEL=omni-moderation-latest
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EVAL_MODEL=gpt-4o
OPENAI_PROMPT_OPTIMIZER_MODEL=gpt-4o

# --- Server / app (ports set in main.py / vite; not env-driven by default) ---
# Backend default: 0.0.0.0:7860
# Frontend default: yarn dev on :5173 ; VITE_BOT_API_URL=http://localhost:7860

# --- Narration (segment-level resume; exact playback offset unavailable) ---
NARRATION_SEGMENT_MAX_CHARACTERS=320
NARRATION_SEGMENT_MIN_CHARACTERS=110
TUTOR_PROMPT_VERSION=v4
# TTS recovery (Iteration 10.4) — no live OpenAI required to set these offline
TTS_NO_AUDIO_MAX_RETRIES=1
TTS_FIRST_AUDIO_TIMEOUT_SECONDS=8
TTS_COMPLETION_TIMEOUT_BASE_SECONDS=12
TTS_COMPLETION_SECONDS_PER_CHAR=0.06
TTS_COMPLETION_TIMEOUT_MAX_SECONDS=90
TTS_MAX_CONSECUTIVE_FAILURES=3

# --- Voice / classroom pacing (non-secret) ---
# Thinking time after a tutor narration comprehension question (seconds).
NO_ANSWER_TIMEOUT_SECONDS=10
# Each Q&A wind-down silence stage (invitation/answer → reminder → closing).
QA_SILENCE_TIMEOUT_SECONDS=12
# After a lesson interruption answer, wait before reminding (does not auto-resume).
LESSON_FOLLOWUP_WAIT_SECONDS=12
# OpenAI TTS speed (0.25–4.0). Default slightly above 1.0 for natural classroom pace.
TTS_SPEECH_SPEED=1.05
# Silero VAD (endpoint detection). Prefer small changes only.
VAD_CONFIDENCE=0.85
VAD_START_SECS=0.45
VAD_STOP_SECS=0.28
VAD_MIN_VOLUME=0.7

# --- Safety / moderation ---
MODERATION_TIMEOUT_SECONDS=3
MODERATION_MAX_CHARACTERS=12000

# --- RAG / knowledge upload limits ---
RAG_TOP_K=4
RAG_MIN_SIMILARITY=0.30
RAG_CHUNK_MAX_CHARACTERS=1600
RAG_CHUNK_OVERLAP_CHARACTERS=200
RAG_MAX_UPLOAD_BYTES=5242880
RAG_MAX_DOCUMENT_CHARACTERS=500000
RAG_MAX_PDF_PAGES=100
RAG_EMBEDDING_BATCH_SIZE=32
RAG_EMBEDDING_TIMEOUT_SECONDS=10

# --- Session metrics ---
METRICS_PERSISTENCE_ENABLED=true
SESSION_DB_PATH=data/tutor_sessions.sqlite3
SESSION_CONFIGURATION_TIMEOUT_SECONDS=5
SESSION_RETENTION_DAYS=30

# --- Transcript persistence (disabled by default; also requires student consent) ---
TRANSCRIPT_PERSISTENCE_ENABLED=false
TRANSCRIPT_MAX_EVENT_CHARACTERS=4000

# --- Flywheel / evaluations (live OpenAI disabled by default) ---
ALLOW_LIVE_FLYWHEEL_OPENAI=false
EVAL_REPETITIONS=3

# --- Frontend public configuration (optional; no secrets) ---
# VITE_BOT_API_URL=http://localhost:7860
